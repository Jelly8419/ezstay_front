# Flutter 빌드 산출물 - 캐시 완전 비활성화
# .part.js, main.dart.js 등이 배포마다 바뀌므로 절대 캐시하면 안 됨
# no-store: 브라우저/CDN 캐시 저장 자체를 금지
/*.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/*.part.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/flutter_bootstrap.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/flutter_service_worker.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/main.dart.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Flutter Manifest 파일들 - 에셋 매핑 정보
# 패키지/에셋 업데이트 시 즉시 반영되어야 함
/assets/AssetManifest.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/assets/AssetManifest.bin
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/assets/AssetManifest.bin.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/assets/FontManifest.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/assets/NOTICES
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# 폰트 파일 - 5분 캐시 + 재검증
# Lucide 등 아이콘 폰트가 패키지 업데이트 시 글리프 추가/제거됨
# must-revalidate로 바뀐 경우 빠르게 반영
/assets/fonts/*
  Cache-Control: public, max-age=300, must-revalidate

/assets/packages/*/fonts/*
  Cache-Control: public, max-age=300, must-revalidate

# sitemap.xml — 순수 XML 보장 (Cloudflare 스크립트 주입 방지)
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex

# robots.txt
/robots.txt
  Content-Type: text/plain; charset=utf-8

# 이미지 등 정적 자원은 24시간 캐시 유지
# (이미지는 파일명이 거의 바뀌지 않으므로 안전)
/assets/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=86400