# Kakao API Keys
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY_HERE
KAKAO_JAVASCRIPT_KEY=YOUR_KAKAO_JAVASCRIPT_KEY_HERE

# Backend API URLs
# Local Development
API_BASE_URL=http://localhost:8080

# Test Server (EC2) - Create .env.test
# API_BASE_URL=https://ezstay-api.duckdns.org

# Production Server - Create .env.production
# API_BASE_URL=https://api.ezstay.com

API_TIMEOUT_SECONDS=10

# Environment
IS_PRODUCTION=false
ENVIRONMENT=development
